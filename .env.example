# Agent Wallet — environment template.
# Copy to .env.local and fill in. NEVER commit a real .env file.

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (added in a later session) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/agent_wallet

# --- Session / auth secret (generate: openssl rand -base64 32) ---
# AUTH_SECRET=

# --- Payment partner sandbox (added when the partner integration starts) ---
# Never expose partner secrets to the browser. Server-side only.
# No NEXT_PUBLIC_ prefix on anything secret.
# PARTNER_API_BASE_URL=
# PARTNER_API_KEY=
